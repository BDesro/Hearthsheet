<UserControl x:Class="Hearthsheet.App.Views.DetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Hearthsheet.App.ViewModels"
             xmlns:views="clr-namespace:Hearthsheet.App.Views"
             xmlns:mvvm="clr-namespace:Hearthsheet.App.Mvvm"
             xmlns:domain="clr-namespace:Hearthsheet.Core.Domain;assembly=Hearthsheet.Core">
    <!-- Categorized editor over the same CharacterViewModel as the sheet and dashboard. -->
    <UserControl.Resources>
        <mvvm:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <mvvm:ClassNameConverter x:Key="ClassName" />
        <Style x:Key="Page" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="24,18" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="Num" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="70" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Wide" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="240" />
        </Style>
        <Style x:Key="Toolbar" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <DataTemplate x:Key="RemoveCell">
            <Button Style="{StaticResource IconButton}" Content="✕" ToolTip="Remove"
                    Command="{Binding DataContext.RemoveEntry, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" AutomationProperties.Name="Remove" />
        </DataTemplate>
        <!-- Class rows are as tall as their combo boxes; centre the plain text cells to line up with them. -->
        <Style x:Key="ClassCellText" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ClassSubclassBox" TargetType="TextBox" BasedOn="{x:Static DataGridTextColumn.DefaultEditingElementStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, Converter={StaticResource ClassName}, StringFormat={}{0} subclass}" />
        </Style>
        <Style x:Key="ClassLevelBox" TargetType="TextBox" BasedOn="{x:Static DataGridTextColumn.DefaultEditingElementStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, Converter={StaticResource ClassName}, StringFormat={}{0} level}" />
        </Style>
        <Style x:Key="ClassDiceBox" TargetType="TextBox" BasedOn="{x:Static DataGridTextColumn.DefaultEditingElementStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, Converter={StaticResource ClassName}, StringFormat={}{0} hit dice left}" />
        </Style>
        <DataTemplate x:Key="RemoveClassCell">
            <Button Content="✕" ToolTip="Remove class"
                    Command="{Binding DataContext.RemoveEntry, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, Converter={StaticResource ClassName}, StringFormat=Remove {0}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.Character.Identity.Classes.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="1">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>
        <!-- Template columns that host their own controls (pickers, combo boxes) are IsReadOnly so the grid never puts the
             cell in edit mode: entering edit mode rebuilds the cell and discards the control being clicked. -->
        <!-- A weapon attack's damage is computed and only its dice override is editable; the reverse for a plain attack. -->
        <Style x:Key="ReadOnlyForWeapon" TargetType="TextBox" BasedOn="{x:Static DataGridTextColumn.DefaultEditingElementStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWeaponAttack}" Value="True"><Setter Property="IsReadOnly" Value="True" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReadOnlyForPlain" TargetType="TextBox" BasedOn="{x:Static DataGridTextColumn.DefaultEditingElementStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWeaponAttack}" Value="False"><Setter Property="IsReadOnly" Value="True" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LockedForWeapon" TargetType="CheckBox" BasedOn="{x:Static DataGridCheckBoxColumn.DefaultEditingElementStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWeaponAttack}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Computed cells are tinted (ReadOnlyFill); editable ones stay white. Per-row variants for attacks. -->
        <Style x:Key="ComputedCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="{StaticResource ReadOnlyFill}" />
        </Style>
        <Style x:Key="ComputedForWeapon" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWeaponAttack}" Value="True"><Setter Property="Background" Value="{StaticResource ReadOnlyFill}" /></DataTrigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoft}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ComputedForPlain" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWeaponAttack}" Value="False"><Setter Property="Background" Value="{StaticResource ReadOnlyFill}" /></DataTrigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoft}" /></Trigger>
            </Style.Triggers>
        </Style>
        <!-- Modifier editor used by items, features and effects. DataContext = Item, Feature or Effect. -->
        <DataTemplate x:Key="ModifierEditor">
            <StackPanel>
                <DockPanel Margin="0,4,0,4">
                    <Button DockPanel.Dock="Right" Content="+ Add modifier"
                            Command="{Binding DataContext.AddModifier, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="Modifiers (applied while active)" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Modifiers}" MaxHeight="180">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Target" Width="Auto" MinWidth="200" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True" ItemsSource="{x:Static mvvm:Lookups.StatTargetKeys}" BorderThickness="0"
                                              Text="{Binding Target, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Modifier target" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridComboBoxColumn Header="Kind" Width="Auto" MinWidth="90" ItemsSource="{x:Static mvvm:Lookups.ModifierKinds}" SelectedItemBinding="{Binding Kind}" />
                        <DataGridTextColumn Header="Value" Width="Auto" MinWidth="70" Binding="{Binding Value}" />
                        <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <TabControl TabStripPlacement="Left" Background="{StaticResource Canvas}" BorderThickness="0" Padding="0">
        <TabControl.Resources>
            <Style TargetType="TabItem" BasedOn="{StaticResource NavTab}" />
        </TabControl.Resources>
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="{StaticResource Sidebar}" Width="190" Padding="0,10">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </DockPanel>
            </ControlTemplate>
        </TabControl.Template>

        <!-- Identity -->
        <TabItem Header="Identity">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Identity" />
                    <TextBlock Style="{StaticResource Hint}" Text="Who the character is. Class defaults can pre-fill hit die, saves, HP and spell slots for built-in classes." />
                    <WrapPanel>
                        <HeaderedContentControl Header="Character name" Style="{StaticResource Field}">
                            <TextBox Style="{StaticResource Wide}" Text="{Binding Character.Identity.Name}" AutomationProperties.Name="Character name" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Player name" Style="{StaticResource Field}">
                            <TextBox Style="{StaticResource Wide}" Text="{Binding Character.Identity.PlayerName}" AutomationProperties.Name="Player name" />
                        </HeaderedContentControl>
                    </WrapPanel>
                    <DockPanel Margin="0,6,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Add class…" Command="{Binding AddClass}" ToolTip="Take a first level in another class (multiclass)" />
                            <Button Content="Level up…" Command="{Binding LevelUp}" />
                            <Button Content="Apply class defaults…" Command="{Binding ApplyClassDefaults}" />
                        </StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center">
                            <Run Text="Classes · Total level" /> <Run Text="{Binding TotalLevel, Mode=OneWay}" /> <Run Text="/ 20" />
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource Danger}" FontWeight="SemiBold"
                               Text="Over 20: the last class will be lowered when the character is next loaded."
                               Visibility="{Binding IsOverLevelCap, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Style="{StaticResource Hint}" Text="The first row is the starting class (it sets saving throw proficiencies and first-level hit points). Hit dice and caster types are per class." />
                    <DataGrid ItemsSource="{Binding Character.Identity.Classes}" AlternationCount="100">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="Auto" MinWidth="90" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Mark" Text="" Foreground="{StaticResource InkMuted}" FontSize="11" VerticalAlignment="Center" Margin="4,0" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="0">
                                                <Setter TargetName="Mark" Property="Text" Value="Starting class" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Class" Width="Auto" MinWidth="150" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" BorderThickness="0" ItemsSource="{x:Static mvvm:Lookups.ClassNames}"
                                                  Text="{Binding Name, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Class name" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Subclass" Width="*" MinWidth="120" Binding="{Binding Subclass}" ElementStyle="{StaticResource ClassCellText}" EditingElementStyle="{StaticResource ClassSubclassBox}" />
                            <DataGridTextColumn Header="Level" Width="Auto" MinWidth="55" Binding="{Binding Level}" ElementStyle="{StaticResource ClassCellText}" EditingElementStyle="{StaticResource ClassLevelBox}" />
                            <DataGridTemplateColumn Header="Hit die" Width="Auto" MinWidth="75" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox BorderThickness="0" ItemsSource="{x:Static mvvm:Lookups.HitDieSizes}" SelectedItem="{Binding HitDie}" ItemStringFormat="d{0}"
                                                  AutomationProperties.Name="{Binding Name, Converter={StaticResource ClassName}, StringFormat={}{0} hit die}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dice left" Width="Auto" MinWidth="65" Binding="{Binding HitDiceRemaining}" ElementStyle="{StaticResource ClassCellText}" EditingElementStyle="{StaticResource ClassDiceBox}" />
                            <DataGridTemplateColumn Header="Caster" Width="Auto" MinWidth="85" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox BorderThickness="0" ItemsSource="{x:Static mvvm:Lookups.CasterTypes}" SelectedItem="{Binding Caster}"
                                                  AutomationProperties.Name="{Binding Name, Converter={StaticResource ClassName}, StringFormat={}{0} caster type}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Ability" Width="Auto" MinWidth="95" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox BorderThickness="0" ItemsSource="{x:Static mvvm:Lookups.OptionalAbilities}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding SpellcastingAbility}" AutomationProperties.Name="{Binding Name, Converter={StaticResource ClassName}, StringFormat={}{0} spellcasting ability}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Content="▲" ToolTip="Move up"
                                                    Command="{Binding DataContext.MoveClassUp, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Name, Converter={StaticResource ClassName}, StringFormat=Move {0} up}" />
                                            <Button Style="{StaticResource IconButton}" Content="▼" ToolTip="Move down"
                                                    Command="{Binding DataContext.MoveClassDown, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Name, Converter={StaticResource ClassName}, StringFormat=Move {0} down}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="36" IsReadOnly="True" CellTemplate="{StaticResource RemoveClassCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel>
                        <HeaderedContentControl Header="Species" Style="{StaticResource Field}">
                            <ComboBox Width="180" IsEditable="True" ItemsSource="{x:Static mvvm:Lookups.Species}"
                                      Text="{Binding Character.Identity.Species, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Species" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Background" Style="{StaticResource Field}">
                            <TextBox Width="180" Text="{Binding Character.Identity.Background}" AutomationProperties.Name="Background" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Alignment" Style="{StaticResource Field}">
                            <ComboBox Width="180" IsEditable="True" ItemsSource="{x:Static mvvm:Lookups.Alignments}"
                                      Text="{Binding Character.Identity.Alignment, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Alignment" />
                        </HeaderedContentControl>
                    </WrapPanel>
                    <WrapPanel>
                        <HeaderedContentControl Header="Experience points" Style="{StaticResource Field}">
                            <TextBox Width="120" Text="{Binding Character.Identity.Experience}" AutomationProperties.Name="Experience points" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Inspiration" Style="{StaticResource Field}">
                            <CheckBox Content="Has inspiration" IsChecked="{Binding Character.Identity.Inspiration}" Margin="0,5,0,0" />
                        </HeaderedContentControl>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Abilities & saves -->
        <TabItem Header="Ability Scores &amp; Saves">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Ability Scores &amp; Saving Throws" />
                    <TextBlock Style="{StaticResource Hint}" Text="Enter base scores (1–30). Modifiers are calculated; items and effects can raise or set scores." />
                    <Grid Margin="0,0,0,6" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource InkMuted}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" /><ColumnDefinition Width="90" /><ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" /><ColumnDefinition Width="110" /><ColumnDefinition Width="90" /><ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ability" /><TextBlock Grid.Column="1" Text="Base score" /><TextBlock Grid.Column="2" Text="Effective" />
                        <TextBlock Grid.Column="3" Text="Modifier" /><TextBlock Grid.Column="4" Text="Save proficient" />
                        <TextBlock Grid.Column="5" Text="Save bonus" /><TextBlock Grid.Column="6" Text="Save total" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Abilities}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AbilityRow}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" /><ColumnDefinition Width="90" /><ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" /><ColumnDefinition Width="110" /><ColumnDefinition Width="90" /><ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBox Grid.Column="1" Style="{StaticResource Num}" Text="{Binding Score}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} base score}" />
                                    <TextBlock Grid.Column="2" Text="{Binding EffectiveScore}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding Modifier, Converter={StaticResource Mod}}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="8,0" />
                                    <CheckBox Grid.Column="4" IsChecked="{Binding Save.Proficient}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} save proficient}" />
                                    <TextBox Grid.Column="5" Style="{StaticResource Num}" Text="{Binding Save.Bonus}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} save bonus}" />
                                    <TextBlock Grid.Column="6" Text="{Binding SaveModifier, Converter={StaticResource Mod}}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="8,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,18,0,0" Foreground="{StaticResource InkMuted}">
                        <Run Text="Proficiency bonus" /> <Run Text="{Binding ProficiencyBonus, Mode=OneWay, Converter={StaticResource Mod}}" FontWeight="SemiBold" />
                        <Run Text="{Binding TotalLevel, Mode=OneWay, StringFormat=  (total level {0})}" />
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Skills -->
        <TabItem Header="Skills">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Skills" />
                    <TextBlock Style="{StaticResource Hint}" Text="Half proficiency covers features like Jack of All Trades. Expertise doubles the proficiency bonus." />
                    <ItemsControl ItemsSource="{Binding Skills}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SkillRow}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" /><ColumnDefinition Width="50" /><ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="90" /><ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding AbilityAbbreviation}" VerticalAlignment="Center" Foreground="{StaticResource InkMuted}" />
                                    <ComboBox Grid.Column="2" Margin="0,0,10,0" ItemsSource="{x:Static mvvm:Lookups.ProficiencyLevels}" SelectedItem="{Binding Model.Proficiency}"
                                              AutomationProperties.Name="{Binding Name, StringFormat={}{0} proficiency}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" /></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Grid.Column="3" Style="{StaticResource Num}" Text="{Binding Model.Bonus}" ToolTip="Extra bonus"
                                             AutomationProperties.Name="{Binding Name, StringFormat={}{0} bonus}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Modifier, Converter={StaticResource Mod}}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Combat -->
        <TabItem Header="Combat">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Combat" />
                    <TextBlock Style="{StaticResource Hint}">
                        <Run Text="Effective values after items and effects: AC" /> <Run Text="{Binding ArmorClass, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · Initiative" /> <Run Text="{Binding Initiative, Mode=OneWay, Converter={StaticResource Mod}}" FontWeight="SemiBold" />
                        <Run Text=" · Speed" /> <Run Text="{Binding Speed, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · Max HP" /> <Run Text="{Binding MaxHitPoints, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · Passive Perception" /> <Run Text="{Binding PassivePerception, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <WrapPanel>
                        <HeaderedContentControl Header="Base armor class" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Combat.ArmorClass}" AutomationProperties.Name="Base armor class" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Initiative bonus" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Combat.InitiativeBonus}" AutomationProperties.Name="Initiative bonus" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Base speed (ft)" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Combat.Speed}" AutomationProperties.Name="Base speed" /></HeaderedContentControl>
                    </WrapPanel>
                    <WrapPanel>
                        <HeaderedContentControl Header="Base max HP" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Combat.MaxHp}" AutomationProperties.Name="Base maximum hit points" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Current HP" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Combat.CurrentHp}" AutomationProperties.Name="Current hit points" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Temporary HP" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Combat.TemporaryHp}" AutomationProperties.Name="Temporary hit points" /></HeaderedContentControl>
                    </WrapPanel>
                    <WrapPanel>
                        <HeaderedContentControl Header="Death save successes" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Combat.DeathSaveSuccesses}" AutomationProperties.Name="Death save successes" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Death save failures" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Combat.DeathSaveFailures}" AutomationProperties.Name="Death save failures" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Stable" Style="{StaticResource Field}"><CheckBox Content="Stable at 0 HP" IsChecked="{Binding Character.Combat.IsStable}" Margin="0,5,0,0" /></HeaderedContentControl>
                    </WrapPanel>

                    <DockPanel Margin="0,14,0,6">
                        <Button DockPanel.Dock="Right" Content="+ Add attack" Command="{Binding AddAttack}" />
                        <TextBlock Text="Attacks" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Pick a weapon to fill in ability, proficiency, to-hit and damage from Equipment; its proficiency comes from the Proficiencies page. Dice override is only for a second attack with the same weapon that rolls different dice (e.g. two-handed versatile 1d10); leave it empty otherwise." />
                    <DataGrid ItemsSource="{Binding Attacks}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="*" MinWidth="120" Binding="{Binding Name}" />
                            <DataGridTemplateColumn Header="Weapon" Width="Auto" MinWidth="120" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox BorderThickness="0" ItemsSource="{Binding DataContext.Character.Weapons, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Model.WeaponId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Weapon" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridComboBoxColumn Header="Ability" Width="Auto" MinWidth="100" ItemsSource="{x:Static mvvm:Lookups.OptionalAbilities}"
                                                    DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValueBinding="{Binding Ability}" />
                            <DataGridCheckBoxColumn Header="Proficient" Width="Auto" Binding="{Binding Proficient, UpdateSourceTrigger=PropertyChanged}" CellStyle="{StaticResource ComputedForWeapon}"
                                                    EditingElementStyle="{StaticResource LockedForWeapon}" />
                            <DataGridTextColumn Header="Extra bonus" Width="Auto" Binding="{Binding Model.Bonus}" />
                            <DataGridTextColumn Header="To hit" Width="Auto" IsReadOnly="True" Binding="{Binding AttackBonus, Converter={StaticResource Mod}}" CellStyle="{StaticResource ComputedCell}" />
                            <DataGridTextColumn Header="Dice override" CellStyle="{StaticResource ComputedForPlain}" Width="Auto" MinWidth="50" Binding="{Binding Model.Dice}" EditingElementStyle="{StaticResource ReadOnlyForPlain}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Weapon attacks only: dice that replace the weapon's, e.g. 1d10 for a two-handed versatile attack. Leave empty to use the weapon's dice." />
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Damage / type" Width="Auto" MinWidth="150" Binding="{Binding DamageRoll}" EditingElementStyle="{StaticResource ReadOnlyForWeapon}" CellStyle="{StaticResource ComputedForWeapon}" />
                            <DataGridTextColumn Header="Notes" Width="*" MinWidth="80" Binding="{Binding Model.Notes}" />
                            <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Proficiencies -->
        <TabItem Header="Proficiencies">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Proficiencies &amp; Languages" />
                    <TextBlock Style="{StaticResource Hint}" Text="Armor, weapon and tool proficiencies and known languages. Skill and saving throw proficiencies are set on their own pages. A weapon proficiency covers every weapon whose name or type matches it; pick types from its list, e.g. Simple, Martial or Longsword. Custom types added in any weapon or proficiency list appear in all of them." />
                    <StackPanel Style="{StaticResource Toolbar}">
                        <Button Content="+ Armor" Command="{Binding AddProficiency}" CommandParameter="{x:Static domain:ProficiencyCategory.Armor}" />
                        <Button Content="+ Weapon" Command="{Binding AddProficiency}" CommandParameter="{x:Static domain:ProficiencyCategory.Weapon}" />
                        <Button Content="+ Tool" Command="{Binding AddProficiency}" CommandParameter="{x:Static domain:ProficiencyCategory.Tool}" />
                        <Button Content="+ Language" Command="{Binding AddProficiency}" CommandParameter="{x:Static domain:ProficiencyCategory.Language}" />
                        <Button Content="+ Other" Command="{Binding AddProficiency}" CommandParameter="{x:Static domain:ProficiencyCategory.Other}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Character.Proficiencies}" MaxHeight="600">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Category" Width="Auto" MinWidth="140" ItemsSource="{x:Static mvvm:Lookups.ProficiencyCategories}" SelectedItemBinding="{Binding Category}" />
                            <DataGridTemplateColumn Header="Name" Width="*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Weapon entries suggest the standard weapon types, so they match the weapons' types exactly. -->
                                        <views:TokenPicker Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Proficiency name">
                                            <views:TokenPicker.Style>
                                                <Style TargetType="views:TokenPicker">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Category}" Value="{x:Static domain:ProficiencyCategory.Weapon}">
                                                            <Setter Property="Options" Value="{Binding DataContext.WeaponTypeOptions, RelativeSource={RelativeSource AncestorType=views:DetailsView}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </views:TokenPicker.Style>
                                        </views:TokenPicker>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Features -->
        <TabItem Header="Features &amp; Traits">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Features &amp; Traits" />
                    <TextBlock Style="{StaticResource Hint}" Text="Class, subclass, species and background features, feats, traits and anything custom. Select a row to edit its description and its permanent effects (modifiers that always apply)." />
                    <StackPanel Style="{StaticResource Toolbar}">
                        <Button Content="+ Add feature" Command="{Binding AddFeature}" />
                    </StackPanel>
                    <DataGrid x:Name="FeatureGrid" ItemsSource="{Binding Character.Features}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}" />
                            <DataGridComboBoxColumn Header="Source" Width="Auto" MinWidth="140" ItemsSource="{x:Static mvvm:Lookups.FeatureSources}" SelectedItemBinding="{Binding Source}" />
                            <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Visibility="{Binding SelectedItem, ElementName=FeatureGrid, Converter={StaticResource VisibleWhen}}">
                        <HeaderedContentControl Header="Description" Style="{StaticResource Field}">
                            <TextBox Style="{StaticResource MultilineBox}" MinHeight="140" Text="{Binding SelectedItem.Description, ElementName=FeatureGrid}"
                                     AutomationProperties.Name="Feature description" />
                        </HeaderedContentControl>
                        <ContentControl Content="{Binding SelectedItem, ElementName=FeatureGrid}" ContentTemplate="{StaticResource ModifierEditor}" IsTabStop="False" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Equipment -->
        <TabItem Header="Equipment">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Equipment" />
                    <TextBlock Style="{StaticResource Hint}">
                        <Run Text="Carrying" /> <Run Text="{Binding CarriedWeightText, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=". Equipped items (attuned, if they require it) apply their modifiers." />
                    </TextBlock>
                    <WrapPanel>
                        <HeaderedContentControl Header="Copper" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Currency.Copper}" AutomationProperties.Name="Copper" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Silver" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Currency.Silver}" AutomationProperties.Name="Silver" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Electrum" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Currency.Electrum}" AutomationProperties.Name="Electrum" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Gold" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Currency.Gold}" AutomationProperties.Name="Gold" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Platinum" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Currency.Platinum}" AutomationProperties.Name="Platinum" /></HeaderedContentControl>
                    </WrapPanel>
                    <StackPanel Style="{StaticResource Toolbar}">
                        <Button Content="+ Add item" Command="{Binding AddItem}" />
                    </StackPanel>
                    <DataGrid x:Name="ItemGrid" ItemsSource="{Binding Character.Items}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Qty" Width="Auto" MinWidth="60" Binding="{Binding Quantity}" />
                            <DataGridTextColumn Header="Weight (lb)" Width="Auto" MinWidth="90" Binding="{Binding Weight}" />
                            <DataGridCheckBoxColumn Header="Equipped" Width="Auto" MinWidth="80" Binding="{Binding Equipped, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridCheckBoxColumn Header="Needs attunement" Width="Auto" MinWidth="130" Binding="{Binding RequiresAttunement, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridCheckBoxColumn Header="Attuned" Width="Auto" MinWidth="70" Binding="{Binding Attuned, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Visibility="{Binding SelectedItem, ElementName=ItemGrid, Converter={StaticResource VisibleWhen}}">
                        <HeaderedContentControl Header="Description / notes" Style="{StaticResource Field}">
                            <TextBox Style="{StaticResource MultilineBox}" Text="{Binding SelectedItem.Description, ElementName=ItemGrid}" AutomationProperties.Name="Item description" />
                        </HeaderedContentControl>
                        <ContentControl Content="{Binding SelectedItem, ElementName=ItemGrid}" ContentTemplate="{StaticResource ModifierEditor}" IsTabStop="False" />
                    </StackPanel>

                    <DockPanel Margin="0,18,0,6">
                        <Button DockPanel.Dock="Right" Content="+ Add weapon" Command="{Binding AddWeapon}" />
                        <TextBlock Text="Weapons" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Each weapon adds an attack on the Combat page. Prof. comes from your weapon proficiencies (Proficiencies page). To hit, Bonus dmg and Additional damage are worked out from your ability, proficiency, modifiers and the weapon's effects; add a +1 enchantment or extra fire damage as an effect. Types (e.g. martial, melee) can be targeted by modifiers such as attack.melee or damage.ranged. Select a weapon to edit its effects." />
                    <DataGrid x:Name="WeaponGrid" ItemsSource="{Binding Weapons}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="*" MinWidth="100" Binding="{Binding Model.Name}" />
                            <DataGridTemplateColumn Header="Types" Width="Auto" MinWidth="130" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <views:TokenPicker Text="{Binding Model.Types, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Weapon types"
                                                           Options="{Binding DataContext.WeaponTypeOptions, RelativeSource={RelativeSource AncestorType=views:DetailsView}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridComboBoxColumn Header="Ability" Width="Auto" MinWidth="95" ItemsSource="{x:Static mvvm:Lookups.OptionalAbilities}"
                                                    DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValueBinding="{Binding Model.Ability}" />
                            <DataGridCheckBoxColumn Header="Prof." Width="Auto" IsReadOnly="True" Binding="{Binding Proficient, Mode=OneWay}" CellStyle="{StaticResource ComputedCell}" />
                            <DataGridTextColumn Header="To hit" Width="Auto" IsReadOnly="True" Binding="{Binding AttackBonus, Converter={StaticResource Mod}}" CellStyle="{StaticResource ComputedCell}" />
                            <DataGridTextColumn Header="Damage" Width="Auto" MinWidth="55" Binding="{Binding Model.Damage}" />
                            <DataGridTextColumn Header="Type" Width="Auto" MinWidth="60" Binding="{Binding Model.DamageType}" />
                            <DataGridTextColumn Header="Bonus dmg" Width="Auto" IsReadOnly="True" Binding="{Binding DamageBonus, Converter={StaticResource Mod}}" CellStyle="{StaticResource ComputedCell}" />
                            <DataGridTextColumn Header="Additional damage" Width="Auto" IsReadOnly="True" Binding="{Binding AdditionalDamage}" CellStyle="{StaticResource ComputedCell}" />
                            <DataGridTextColumn Header="Special effects" Width="*" MinWidth="100" Binding="{Binding Model.Notes}" />
                            <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Visibility="{Binding SelectedItem, ElementName=WeaponGrid, Converter={StaticResource VisibleWhen}}">
                        <DockPanel Margin="0,8,0,4">
                            <Button DockPanel.Dock="Right" Content="+ Add weapon effect" Command="{Binding AddWeaponEffect}" CommandParameter="{Binding SelectedItem.Model, ElementName=WeaponGrid}" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                <Run Text="{Binding SelectedItem.Model.Name, ElementName=WeaponGrid, Mode=OneWay, StringFormat=Effects on {0}}" FontWeight="SemiBold" />
                                <Run Text="  Damage with no type (or the weapon's type) joins its main damage." Foreground="{StaticResource InkMuted}" />
                            </TextBlock>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding SelectedItem.Model.Effects, ElementName=WeaponGrid}" MaxHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Effect" Width="*" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="To hit" Width="Auto" MinWidth="60" Binding="{Binding ToHit}" />
                                <DataGridTextColumn Header="Damage" Width="Auto" MinWidth="80" Binding="{Binding Damage}" />
                                <DataGridTextColumn Header="Damage type" Width="Auto" MinWidth="110" Binding="{Binding DamageType}" />
                                <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <DockPanel Margin="0,18,0,6">
                        <Button DockPanel.Dock="Right" Content="+ Add wondrous item" Command="{Binding AddWondrousItem}" />
                        <TextBlock Text="Wondrous items" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Select an item to set what it changes (e.g. Cloak of Protection: ac +1, save.all +1). Its modifiers apply only while it is equipped (and attuned, if it needs attunement)." />
                    <DataGrid x:Name="WondrousGrid" ItemsSource="{Binding Character.WondrousItems}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Weight (lb)" Width="Auto" MinWidth="90" Binding="{Binding Weight}" />
                            <DataGridCheckBoxColumn Header="Equipped" Width="Auto" MinWidth="80" Binding="{Binding Equipped, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridCheckBoxColumn Header="Needs attunement" Width="Auto" MinWidth="130" Binding="{Binding RequiresAttunement, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridCheckBoxColumn Header="Attuned" Width="Auto" MinWidth="70" Binding="{Binding Attuned, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Visibility="{Binding SelectedItem, ElementName=WondrousGrid, Converter={StaticResource VisibleWhen}}">
                        <HeaderedContentControl Header="Description" Style="{StaticResource Field}">
                            <TextBox Style="{StaticResource MultilineBox}" Text="{Binding SelectedItem.Description, ElementName=WondrousGrid}" AutomationProperties.Name="Wondrous item description" />
                        </HeaderedContentControl>
                        <ContentControl Content="{Binding SelectedItem, ElementName=WondrousGrid}" ContentTemplate="{StaticResource ModifierEditor}" IsTabStop="False" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Spells -->
        <TabItem Header="Spells">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Spellcasting" />
                    <TextBlock Style="{StaticResource Hint}">
                        <Run Text="Spell save DC" /> <Run Text="{Binding SpellSaveDc, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · Spell attack" /> <Run Text="{Binding SpellAttackBonus, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=". Spell text is yours to enter — no rulebook text is bundled." />
                    </TextBlock>
                    <WrapPanel>
                        <HeaderedContentControl Header="Spellcasting class" Style="{StaticResource Field}">
                            <TextBox Width="180" Text="{Binding Character.Spellcasting.SpellcastingClass}" AutomationProperties.Name="Spellcasting class" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Concentrating on" Style="{StaticResource Field}">
                            <TextBox Width="180" Text="{Binding Character.Spellcasting.Concentration}" AutomationProperties.Name="Concentrating on" />
                        </HeaderedContentControl>
                    </WrapPanel>
                    <TextBlock Text="Spell slots" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,6" />
                    <ItemsControl ItemsSource="{Binding Character.Spellcasting.Slots}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type domain:SpellSlotLevel}">
                                <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,8,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Level, StringFormat=Level {0}}" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Max" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource InkMuted}" />
                                            <TextBox Width="36" HorizontalContentAlignment="Center" Text="{Binding Maximum}" AutomationProperties.Name="{Binding Level, StringFormat=Level {0} slots maximum}" />
                                            <TextBlock Text="Used" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{StaticResource InkMuted}" />
                                            <TextBox Width="36" HorizontalContentAlignment="Center" Text="{Binding Expended}" AutomationProperties.Name="{Binding Level, StringFormat=Level {0} slots used}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,8,8" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Pact Magic" FontWeight="SemiBold" ToolTip="Warlock-style slots that come back on a short rest. Enter them by hand for features like Profane Soul." />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Level" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource InkMuted}" />
                                <TextBox Width="36" HorizontalContentAlignment="Center" Text="{Binding Character.Spellcasting.PactSlots.Level}" AutomationProperties.Name="Pact slot level" />
                                <TextBlock Text="Max" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{StaticResource InkMuted}" />
                                <TextBox Width="36" HorizontalContentAlignment="Center" Text="{Binding Character.Spellcasting.PactSlots.Maximum}" AutomationProperties.Name="Pact slots maximum" />
                                <TextBlock Text="Used" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{StaticResource InkMuted}" />
                                <TextBox Width="36" HorizontalContentAlignment="Center" Text="{Binding Character.Spellcasting.PactSlots.Expended}" AutomationProperties.Name="Pact slots used" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <DockPanel Margin="0,8,0,6">
                        <Button DockPanel.Dock="Right" Content="+ Add spell" Command="{Binding AddSpell}" CommandParameter="{Binding SelectedItem.Level, ElementName=SpellGrid}" />
                        <TextBlock Text="Spells" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid x:Name="SpellGrid" ItemsSource="{Binding Character.Spellcasting.Spells}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Prep." Width="Auto" MinWidth="50" Binding="{Binding Prepared, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridComboBoxColumn Header="Lvl" Width="Auto" MinWidth="55" ItemsSource="{x:Static mvvm:Lookups.SpellLevels}" SelectedItemBinding="{Binding Level}" />
                            <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}" />
                            <DataGridTemplateColumn Header="Class" Width="Auto" MinWidth="90" IsReadOnly="True"
                                                    Visibility="{Binding Data.IsMultiCaster, Source={StaticResource Proxy}, Converter={StaticResource VisibleWhen}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" BorderThickness="0" ItemsSource="{Binding Data.CasterNames, Source={StaticResource Proxy}}"
                                                  Text="{Binding Class, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Spell class" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="School" Width="Auto" MinWidth="120" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" BorderThickness="0" ItemsSource="{x:Static mvvm:Lookups.SpellSchools}"
                                                  Text="{Binding School, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="School" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Casting time" Width="Auto" MinWidth="95" Binding="{Binding CastingTime}" />
                            <DataGridTextColumn Header="Range" Width="Auto" MinWidth="80" Binding="{Binding Range}" />
                            <DataGridTextColumn Header="Components" Width="Auto" MinWidth="90" Binding="{Binding Components}" />
                            <DataGridTextColumn Header="Duration" Width="Auto" MinWidth="95" Binding="{Binding Duration}" />
                            <DataGridCheckBoxColumn Header="Conc." Width="Auto" MinWidth="50" Binding="{Binding Concentration, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridCheckBoxColumn Header="Ritual" Width="Auto" MinWidth="50" Binding="{Binding Ritual, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Visibility="{Binding SelectedItem, ElementName=SpellGrid, Converter={StaticResource VisibleWhen}}">
                        <HeaderedContentControl Header="Description" Style="{StaticResource Field}">
                            <TextBox Style="{StaticResource MultilineBox}" MinHeight="110" Text="{Binding SelectedItem.Description, ElementName=SpellGrid}" AutomationProperties.Name="Spell description" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="At higher levels" Style="{StaticResource Field}">
                            <TextBox Style="{StaticResource MultilineBox}" Text="{Binding SelectedItem.HigherLevels, ElementName=SpellGrid}" AutomationProperties.Name="Higher level casting" />
                        </HeaderedContentControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Resources -->
        <TabItem Header="Resources">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Resources" />
                    <TextBlock Style="{StaticResource Hint}" Text="Limited-use abilities and counters. 'Recovers' decides what rests refill; leave 'Amount' empty to refill completely. Manual resources are flagged after rests for you to adjust." />
                    <StackPanel Style="{StaticResource Toolbar}">
                        <Button Content="+ Add resource" Command="{Binding AddResource}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Character.Resources}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Current" Width="Auto" MinWidth="70" Binding="{Binding Current}" />
                            <DataGridTextColumn Header="Maximum" Width="Auto" MinWidth="75" Binding="{Binding Maximum}" />
                            <DataGridComboBoxColumn Header="Recovers" Width="Auto" MinWidth="150" ItemsSource="{x:Static mvvm:Lookups.RecoveryTimings}" SelectedItemBinding="{Binding Recovery}" />
                            <DataGridTextColumn Header="Amount" Width="Auto" MinWidth="70" Binding="{Binding RecoveryAmount, TargetNullValue=''}" />
                            <DataGridTextColumn Header="Notes" Width="*" Binding="{Binding Notes}" />
                            <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Conditions & effects -->
        <TabItem Header="Conditions &amp; Effects">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Conditions &amp; Effects" />
                    <TextBlock Style="{StaticResource Hint}" Text="Conditions are tracked for reference. Effects (Bless, potions, curses…) can carry modifiers and expire automatically on rests." />
                    <ItemsControl ItemsSource="{Binding Conditions}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConditionToggle}">
                                <ToggleButton Style="{StaticResource PillToggle}" Content="{Binding Name}" IsChecked="{Binding IsActive}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <HeaderedContentControl Header="Exhaustion level (0–6)" Style="{StaticResource Field}" Margin="0,8,0,12">
                        <TextBox Style="{StaticResource Num}" Text="{Binding Character.ExhaustionLevel}" AutomationProperties.Name="Exhaustion level" />
                    </HeaderedContentControl>
                    <DockPanel Margin="0,4,0,6">
                        <Button DockPanel.Dock="Right" Content="+ Add effect" Command="{Binding AddEffect}" />
                        <TextBlock Text="Active effects" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid x:Name="EffectGrid" ItemsSource="{Binding Character.Effects}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Duration" Width="Auto" MinWidth="120" Binding="{Binding Duration}" />
                            <DataGridComboBoxColumn Header="Expires" Width="Auto" MinWidth="150" ItemsSource="{x:Static mvvm:Lookups.EffectExpiries}" SelectedItemBinding="{Binding Expiry}" />
                            <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Visibility="{Binding SelectedItem, ElementName=EffectGrid, Converter={StaticResource VisibleWhen}}">
                        <HeaderedContentControl Header="Description" Style="{StaticResource Field}">
                            <TextBox Style="{StaticResource MultilineBox}" Text="{Binding SelectedItem.Description, ElementName=EffectGrid}" AutomationProperties.Name="Effect description" />
                        </HeaderedContentControl>
                        <ContentControl Content="{Binding SelectedItem, ElementName=EffectGrid}" ContentTemplate="{StaticResource ModifierEditor}" IsTabStop="False" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Biography -->
        <TabItem Header="Biography &amp; Notes">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Biography &amp; Notes" />
                    <WrapPanel Margin="0,8,0,0">
                        <HeaderedContentControl Header="Age" Style="{StaticResource Field}"><TextBox Width="110" Text="{Binding Character.Biography.Age}" AutomationProperties.Name="Age" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Height" Style="{StaticResource Field}"><TextBox Width="110" Text="{Binding Character.Biography.Height}" AutomationProperties.Name="Height" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Weight" Style="{StaticResource Field}"><TextBox Width="110" Text="{Binding Character.Biography.Weight}" AutomationProperties.Name="Weight" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Eyes" Style="{StaticResource Field}"><TextBox Width="110" Text="{Binding Character.Biography.Eyes}" AutomationProperties.Name="Eyes" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Skin" Style="{StaticResource Field}"><TextBox Width="110" Text="{Binding Character.Biography.Skin}" AutomationProperties.Name="Skin" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Hair" Style="{StaticResource Field}"><TextBox Width="110" Text="{Binding Character.Biography.Hair}" AutomationProperties.Name="Hair" /></HeaderedContentControl>
                    </WrapPanel>
                    <HeaderedContentControl Header="Personality traits" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" Text="{Binding Character.Biography.PersonalityTraits}" AutomationProperties.Name="Personality traits" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Ideals" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" Text="{Binding Character.Biography.Ideals}" AutomationProperties.Name="Ideals" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Bonds" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" Text="{Binding Character.Biography.Bonds}" AutomationProperties.Name="Bonds" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Flaws" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" Text="{Binding Character.Biography.Flaws}" AutomationProperties.Name="Flaws" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Appearance" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" Text="{Binding Character.Biography.Appearance}" AutomationProperties.Name="Appearance" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Backstory" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" MinHeight="140" Text="{Binding Character.Biography.Backstory}" AutomationProperties.Name="Backstory" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Allies &amp; organizations" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" Text="{Binding Character.Biography.Allies}" AutomationProperties.Name="Allies" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Treasure" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" Text="{Binding Character.Biography.Treasure}" AutomationProperties.Name="Treasure" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Notes" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" MinHeight="140" Text="{Binding Character.Biography.Notes}" AutomationProperties.Name="Notes" /></HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
