@* TEMPORARY Task 8 dev page: Debug builds only (excluded from Release in the csproj), removed in Task 11. *@
@using Hearthsheet.Core.Content
@implements IDisposable

<section aria-label="Storage dev page">
    <h2>Storage dev page (temporary, Debug only)</h2>
    <p id="journal-state" role="status">@(Account.Journal.Failed ? "Failed: not saved on this device" : "Saved on this device")</p>
    <button type="button" @onclick="Save">Save a character</button>
    <button type="button" @onclick="() => Account.Journal.RetryAsync()">Try again</button>
    <ul id="characters">
        @foreach (var c in Account.Store.List())
        {
            <li>@c.Name</li>
        }
    </ul>
</section>

@code {
    [Parameter, EditorRequired] public AccountSession Account { get; set; } = null!;

    protected override void OnInitialized() => Account.Journal.StateChanged += OnStateChanged;

    private void Save() =>
        Account.Store.Save(CharacterFactory.Create(new NewCharacterOptions($"Dev {DateTime.Now:HH:mm:ss.fff}", "Fighter", 1, "Human", "Soldier")));

    private void OnStateChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Account.Journal.StateChanged -= OnStateChanged;
}
