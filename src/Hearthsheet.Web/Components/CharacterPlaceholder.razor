@* Stands in for the Play, Details and Sheet views until Phases 3–5; the name edits the open character directly. *@
@using Hearthsheet.Core.Domain

<section class="character" aria-labelledby="character-title">
    <h2 id="character-title">Character</h2>
    <label for="character-name">Name</label>
    <input id="character-name" @bind="Character.Identity.Name" @bind:event="oninput" />
    <p>The Play, Details and Sheet views arrive in later previews.</p>
</section>

@code {
    [Parameter, EditorRequired] public Character Character { get; set; } = null!;
}
