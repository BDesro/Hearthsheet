<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette: warm paper neutrals, dark ink, one crimson accent. Keep the keys identical in Light.xaml and Dark.xaml (ThemeTests), and reference them with DynamicResource. -->
    <SolidColorBrush x:Key="Ink" Color="#1F1B16" />
    <SolidColorBrush x:Key="InkMuted" Color="#6B6259" />
    <SolidColorBrush x:Key="Accent" Color="#8E2A22" />
    <SolidColorBrush x:Key="AccentHover" Color="#A63A30" />
    <SolidColorBrush x:Key="AccentSoft" Color="#F3E3DF" />
    <SolidColorBrush x:Key="AccentPressed" Color="#E8CFC9" />
    <!-- Text on Accent fills. -->
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <!-- Read-only (computed) table cells: a shade off the surface, so editable cells stand out. -->
    <SolidColorBrush x:Key="ReadOnlyFill" Color="#F5F2EC" />
    <SolidColorBrush x:Key="Canvas" Color="#F4F1EB" />
    <SolidColorBrush x:Key="Sidebar" Color="#ECE7DE" />
    <SolidColorBrush x:Key="SidebarHover" Color="#E2DCD1" />
    <SolidColorBrush x:Key="Line" Color="#D8D1C5" />
    <SolidColorBrush x:Key="LineStrong" Color="#B9AFA0" />
    <SolidColorBrush x:Key="Good" Color="#2F6B3A" />
    <SolidColorBrush x:Key="Danger" Color="#A12C2C" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FBEFED" />
    <!-- Behind the white sheet pages. -->
    <SolidColorBrush x:Key="SheetBackdrop" Color="#D9D4CB" />
    <!-- Behind the intro video: dark in both themes. -->
    <SolidColorBrush x:Key="IntroBackdrop" Color="#101212" />
</ResourceDictionary>
