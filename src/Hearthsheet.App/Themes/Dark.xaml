<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette: warm charcoal surfaces, parchment ink, a lightened crimson accent. Keep the keys identical in Light.xaml and Dark.xaml (ThemeTests), and reference them with DynamicResource. -->
    <SolidColorBrush x:Key="Ink" Color="#EDE6DA" />
    <SolidColorBrush x:Key="InkMuted" Color="#B5A99B" />
    <SolidColorBrush x:Key="Accent" Color="#E5837A" />
    <SolidColorBrush x:Key="AccentHover" Color="#EE998F" />
    <SolidColorBrush x:Key="AccentSoft" Color="#4A2C27" />
    <SolidColorBrush x:Key="AccentPressed" Color="#5A332D" />
    <!-- Text on Accent fills. -->
    <SolidColorBrush x:Key="OnAccent" Color="#1F1B16" />
    <SolidColorBrush x:Key="Surface" Color="#2A2420" />
    <!-- Read-only (computed) table cells: a shade off the surface, so editable cells stand out. -->
    <SolidColorBrush x:Key="ReadOnlyFill" Color="#322B26" />
    <SolidColorBrush x:Key="Canvas" Color="#1B1714" />
    <SolidColorBrush x:Key="Sidebar" Color="#221D19" />
    <SolidColorBrush x:Key="SidebarHover" Color="#2E2722" />
    <SolidColorBrush x:Key="Line" Color="#3E3630" />
    <SolidColorBrush x:Key="LineStrong" Color="#62574D" />
    <SolidColorBrush x:Key="Good" Color="#86C994" />
    <SolidColorBrush x:Key="Danger" Color="#F0908A" />
    <SolidColorBrush x:Key="DangerSoft" Color="#3D2220" />
    <!-- Behind the white sheet pages. -->
    <SolidColorBrush x:Key="SheetBackdrop" Color="#141110" />
    <!-- Behind the intro video: dark in both themes. -->
    <SolidColorBrush x:Key="IntroBackdrop" Color="#101212" />
    <!--
        Dark only: Windows' own control parts (a table cell's edit box, a scroll corner, disabled text) read these
        system colours. Light mode keeps Windows' values, so they aren't in Light.xaml (ThemeTests skip {x:Static} keys).
    -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2A2420" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#EDE6DA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#221D19" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#EDE6DA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#3E3630" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#62574D" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#B5A99B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E5837A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1F1B16" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#4A2C27" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#EDE6DA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#2A2420" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#EDE6DA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2A2420" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#EDE6DA" />
</ResourceDictionary>
