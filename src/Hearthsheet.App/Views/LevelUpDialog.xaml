<Window x:Class="Hearthsheet.App.Views.LevelUpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mvvm="clr-namespace:Hearthsheet.App.Mvvm"
        Title="Level up" Style="{StaticResource AppWindow}" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=ClassBox}">
    <StackPanel Margin="22,18" Width="420">
        <TextBlock Style="{StaticResource SectionTitle}" Text="Level up" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="Pick a class you already have to raise it, or a new one to multiclass. Saving throws stay as they are; features and spells are added by hand afterwards." />
        <HeaderedContentControl Header="Class" Style="{StaticResource Field}">
            <ComboBox x:Name="ClassBox" Width="200" HorizontalAlignment="Left" IsEditable="True" AutomationProperties.Name="Class to level up"
                      SelectionChanged="OnChanged" TextBoxBase.TextChanged="OnChanged" />
        </HeaderedContentControl>

        <!-- A class that isn't built in needs its facts entered. -->
        <WrapPanel x:Name="CustomPanel" Visibility="Collapsed">
            <HeaderedContentControl Header="Hit die" Style="{StaticResource Field}">
                <ComboBox x:Name="DieBox" Width="80" ItemsSource="{x:Static mvvm:Lookups.HitDieSizes}" SelectedIndex="1"
                          ItemStringFormat="d{0}" AutomationProperties.Name="New class hit die" SelectionChanged="OnChanged" />
            </HeaderedContentControl>
            <HeaderedContentControl Header="Caster" Style="{StaticResource Field}">
                <ComboBox x:Name="CasterBox" Width="100" ItemsSource="{x:Static mvvm:Lookups.CasterTypes}" SelectedIndex="0"
                          AutomationProperties.Name="New class caster type" />
            </HeaderedContentControl>
            <HeaderedContentControl Header="Spellcasting ability" Style="{StaticResource Field}">
                <ComboBox x:Name="AbilityBox" Width="130" ItemsSource="{x:Static mvvm:Lookups.OptionalAbilities}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedIndex="0" AutomationProperties.Name="New class spellcasting ability" />
            </HeaderedContentControl>
        </WrapPanel>

        <TextBlock Text="Hit points" FontWeight="SemiBold" Margin="0,2,0,4" />
        <RadioButton x:Name="AverageRadio" IsChecked="True" GroupName="Hp" Margin="0,0,0,4" Checked="OnChanged" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="RollRadio" GroupName="Hp" Content="Roll" VerticalAlignment="Center" Checked="OnChanged" AutomationProperties.Name="Roll hit points" />
            <TextBox x:Name="RollBox" Width="56" Margin="8,0,0,0" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=RollRadio}"
                     AutomationProperties.Name="Hit point roll" />
            <Button x:Name="RollButton" Content="🎲 Roll for me" Margin="8,0,0,0" Click="OnRoll" IsEnabled="{Binding IsChecked, ElementName=RollRadio}" />
        </StackPanel>

        <TextBlock x:Name="WarningText" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource Danger}" Visibility="Collapsed" />
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource Danger}" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="OK" IsDefault="True" Style="{StaticResource AccentButton}" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
