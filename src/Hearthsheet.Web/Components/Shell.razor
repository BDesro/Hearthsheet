@* The signed-in shell: account menu, character list, the open character and the status bar, over one account's store. *@
@using System.Text
@using Hearthsheet.Cloud
@using Hearthsheet.Core.Rules
@using Hearthsheet.Presentation
@using Hearthsheet.Web.Storage
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@implements IDisposable
@inject WebDialogs Dialogs
@inject WebHelp Help
@inject ILoggerFactory Loggers
@inject MemoryLogProvider Logs
@inject IJSRuntime JS

<div class="shell">
    @* Toolbar: large buttons for the common commands; ⋯ More always lists everything, so buttons hidden on narrow
       screens (see app.css) stay reachable. Menus close on a pick, outside click or Escape (js/hearthsheet.js). *@
    <header class="app-bar">
        <h1>Hearthsheet</h1>
        <div class="toolbar" role="toolbar" aria-label="Commands">
            <button type="button" class="tool" @onclick="_shell.CreateAsync">
                <span class="glyph" aria-hidden="true">+</span><span class="label">New character</span>
            </button>
            <button type="button" class="tool hide-narrow" @onclick="Print" disabled="@(_shell.Current is null)">
                <svg class="glyph" aria-hidden="true" viewBox="0 0 16 16"><path d="M4 6V1.5h8V6M4 12H2V6h12v6h-2M4 9.5h8v5H4z" /></svg><span class="label">Print sheet</span>
            </button>
            <button type="button" class="tool hide-narrow" @onclick="_sync.RunAsync" disabled="@_sync.IsBusy">
                <svg class="glyph" aria-hidden="true" viewBox="0 0 16 16"><path d="M13.5 6.5A5.5 5.5 0 0 0 3.2 4.6M2.5 9.5a5.5 5.5 0 0 0 10.3 1.9M3 1.5v3.3h3.3M13 14.5v-3.3H9.7" /></svg><span class="label">Sync now</span>
            </button>
            <details class="menu-button hide-narrow">
                <summary class="tool"><span class="glyph" aria-hidden="true">?</span><span class="label">Help</span><span aria-hidden="true"> ▾</span></summary>
                <div class="menu">
                    @HelpItems
                </div>
            </details>
        </div>
        <details class="menu-button more">
            <summary class="tool" aria-label="More commands"><span class="glyph" aria-hidden="true">⋯</span><span class="label">More</span></summary>
            <div class="menu">
                <p class="menu-account muted">@(Account.Email ?? "Signed in")</p>
                <hr />
                <button type="button" @onclick="_shell.CreateAsync">New character</button>
                <button type="button" @onclick="Print" disabled="@(_shell.Current is null)">Print sheet</button>
                <button type="button" disabled="@_sync.IsBusy" @onclick="_sync.RunAsync">Sync now</button>
                <hr />
                @HelpItems
                <hr />
                <button type="button" @onclick="ExportAllAsync">Export all characters</button>
                <button type="button" @onclick="DownloadDiagnosticsAsync">Download diagnostics</button>
                <hr />
                <div class="menu-group" role="group" aria-label="Theme">
                    <span class="muted">Theme</span>
                    @foreach (var (value, label) in Themes)
                    {
                        <button type="button" aria-pressed="@(_theme == value ? "true" : "false")" @onclick="() => SetThemeAsync(value)">
                            <span class="check" aria-hidden="true">@(_theme == value ? "✓" : "")</span>@label
                        </button>
                    }
                </div>
                <hr />
                <button type="button" @onclick="SignOut">Sign out</button>
            </div>
        </details>
    </header>
    <nav class="sidebar" aria-label="Characters">
        <CharacterList Shell="_shell" Account="Account" Storage="Storage" />
    </nav>
    <main class="main">
        @if (_shell.Current is { } current)
        {
            @* The desktop's view tabs, with the character's name at the right. *@
            <div class="view-bar">
                <div class="view-tabs" role="group" aria-label="View">
                    @foreach (var view in Views)
                    {
                        <button type="button" aria-pressed="@(view == _view ? "true" : "false")" @onclick="() => _view = view">@view</button>
                    }
                </div>
                <CharacterTitle @key="current" Vm="current" />
            </div>
            @if (_view == SheetTab)
            {
                <SheetView @key="current" Vm="current" />
            }
            else if (_view == "Details")
            {
                <DetailsView @key="current" Vm="current" />
            }
            else
            {
                <PlayView @key="current" Vm="current" />
            }
        }
        else
        {
            <div class="empty-state">
                <h2>No character open</h2>
                <p class="hint">Create a new character to fill in the sheet, or import one exported from Hearthsheet.</p>
                <button type="button" class="accent" @onclick="_shell.CreateAsync">Create character</button>
            </div>
        }
    </main>
    <StatusBar Shell="_shell" Account="Account" Sync="_sync" Secrets="Storage.Secrets.Journal" />
</div>

@code {
    private const string SheetTab = "Character Sheet";
    private static readonly string[] Views = [SheetTab, "Details", "Play"];
    private string _view = "Play";
    private bool _print; // Ctrl+P: print once the sheet has rendered
    private ShellViewModel _shell = null!;
    private WebSync _sync = null!;
    private IJSObjectReference? _js;
    private DotNetObjectReference<Shell>? _ref;
    private bool _disposed;
    private static int s_lastWatchId;
    private readonly int _watchId = ++s_lastWatchId; // the browser has one thread
    private static readonly (string Value, string Label)[] Themes = [("system", "Match system"), ("light", "Light"), ("dark", "Dark")];
    private string _theme = "system"; // js/theme.js keeps the choice per device

    private async Task SetThemeAsync(string theme)
    {
        _theme = theme;
        await JS.InvokeVoidAsync("hearthsheetTheme.set", theme);
    }

    // In both the Help ▾ menu and ⋯ More.
    private RenderFragment HelpItems => @<text>
        <button type="button" @onclick="() => Help.Open(HelpDocs.Tutorial)">Tutorial</button>
        <button type="button" @onclick="() => Help.Open(HelpDocs.BeginnersGuide)">Beginner's guide to 5e</button>
        <a href="@HelpDocs.WikidotUrl" target="_blank" rel="noopener noreferrer">Look up rules (D&amp;D 5e wikidot)</a>
        <button type="button" @onclick="() => Help.Open(HelpDocs.Legal)">Legal and credits</button>
    </text>;

    [Parameter, EditorRequired] public AccountSession Account { get; set; } = null!;
    [Parameter, EditorRequired] public BrowserStorage Storage { get; set; } = null!;
    [Parameter] public EventCallback SignOut { get; set; }

    /// <summary>A pass finished; the app re-renders (a pass can end the session: "Signed out – sign in to resume sync").</summary>
    [Parameter] public EventCallback SyncChanged { get; set; }

    private ILogger Log => Loggers.CreateLogger<Shell>();

    protected override void OnInitialized()
    {
        // Back from the sign-out question: reopen the character that was open.
        var reopen = Account.OpenCharacter();
        _shell = new ShellViewModel(Account.Store, Account.Library, RestService.CreateDefault(), Dialogs, Loggers,
            action => _ = InvokeAsync(action), TimeProvider.System, Account.Sync);
        Account.Save = () => _shell.Save();
        Account.OpenCharacter = () => _shell.OpenCharacterId;
        _shell.PropertyChanged += OnChanged;
        _shell.Characters.CollectionChanged += OnChanged;
        _shell.Start();
        if (reopen is { } id && _shell.Characters.FirstOrDefault(c => c.Id == id) is { } summary) _shell.SelectedSummary = summary;

        _sync = new WebSync(Account.Sync, _shell, Account.Auth, Account.UserId, Account.Journal, Loggers.CreateLogger<WebSync>(),
            action => _ = InvokeAsync(action), TimeProvider.System);
        _sync.Changed += OnSyncChanged;
        Account.WebSync = _sync;
        _ = _sync.RunAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_print)
        {
            _print = false;
            await JS.InvokeVoidAsync("print");
        }
        if (!firstRender) return;
        _theme = await JS.InvokeAsync<string>("hearthsheetTheme.get");
        StateHasChanged();
        var js = await JS.InvokeAsync<IJSObjectReference>("import", "./js/hearthsheet.js");
        if (_disposed) return;
        (_js, _ref) = (js, DotNetObjectReference.Create(this));
        _sync.IsVisible = await _js.InvokeAsync<bool>("watchPage", _ref, _watchId);
    }

    [JSInvokable] public void Online() => _sync.Online();
    [JSInvokable] public void Visible(bool visible) => _sync.IsVisible = visible;

    // Ctrl/Cmd+P prints the sheet, from any view (spec 22).
    [JSInvokable]
    public void Print()
    {
        if (_shell.Current is null) return;
        _view = SheetTab;
        _print = true;
        StateHasChanged();
    }

    // Ctrl/Cmd+S saves now, as on the desktop, instead of the browser's "Save page as".
    [JSInvokable] public void Save() => _shell.Save();

    private void OnSyncChanged() => _ = InvokeAsync(SyncChanged.InvokeAsync);

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private async Task ExportAllAsync()
    {
        if (!_shell.Save()) return;
        try
        {
            using var zip = new MemoryStream();
            var skipped = Account.Library.ExportAll(zip);
            await Storage.DownloadAsync($"Hearthsheet characters {DateTime.Now:yyyy-MM-dd}.zip", "application/zip", zip.ToArray());
            if (skipped.Count > 0)
                await Dialogs.ErrorAsync($"These characters could not be read and are not in the zip:\n\n{string.Join("\n", skipped)}");
        }
        catch (JSException ex)
        {
            Log.LogError(ex, "Export all failed");
            await Dialogs.ErrorAsync("The characters could not be exported. Try again.");
        }
    }

    // The in-memory log of this session, already redacted (spec 22).
    private async Task DownloadDiagnosticsAsync()
    {
        try
        {
            await Storage.DownloadAsync($"Hearthsheet diagnostics {DateTime.Now:yyyy-MM-dd HHmm}.txt", "text/plain",
                Encoding.UTF8.GetBytes(Logs.Snapshot()));
        }
        catch (JSException ex)
        {
            Log.LogError(ex, "Downloading diagnostics failed");
            await Dialogs.ErrorAsync("The diagnostics could not be downloaded. Try again.");
        }
    }

    public void Dispose()
    {
        // Account.Save stays pointed at this view model: a lock release or sign-out after unmounting still saves through it.
        _shell.PropertyChanged -= OnChanged;
        _shell.Characters.CollectionChanged -= OnChanged;
        _disposed = true;
        _sync.Changed -= OnSyncChanged;
        _sync.Dispose();
        if (_js is not null) _ = _js.InvokeVoidAsync("unwatchPage", _watchId).AsTask();
        _ref?.Dispose();
    }
}
