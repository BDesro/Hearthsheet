<Window x:Class="Hearthsheet.App.Views.ResourceUseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Name, StringFormat=Use {0}}" Style="{StaticResource AppWindow}" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="22,18" Width="420">
        <TextBlock Style="{StaticResource SectionTitle}">
            <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="{Binding UsesText, Mode=OneWay}" Foreground="{DynamicResource InkMuted}" FontWeight="Normal" />
        </TextBlock>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Roll your physical dice and type them in, or let the app roll whatever is still empty." />
        <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Foreground="{DynamicResource Ink}">
            <Run Text="Roll " /><Run Text="{Binding FormulaText, Mode=OneWay}" />
        </TextBlock>

        <ItemsControl ItemsSource="{Binding Boxes}" IsTabStop="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="56" HorizontalContentAlignment="Center"
                                     Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{Binding Label, StringFormat={}{0} roll}" />
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Ink}" Text="{Binding Label}" />
                            <TextBlock VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource InkMuted}">
                                <Run Text="(" /><Run Text="{Binding Min, Mode=OneWay}" /><Run Text="–" /><Run Text="{Binding Max, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Margin="64,2,0,0" Foreground="{DynamicResource Danger}" Text="{Binding Error}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,14" Foreground="{DynamicResource Ink}" Text="{Binding SummaryText}" />

        <DockPanel>
            <Button DockPanel.Dock="Left" Content="🎲 Roll for me" Command="{Binding RollForMe}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Use" IsDefault="True" Style="{StaticResource AccentButton}" IsEnabled="{Binding CanUse}" Click="OnUse" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
