<Window x:Class="Hearthsheet.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Background="{DynamicResource Surface}" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- The app's own message box, so confirmations follow the theme (Windows' MessageBox stays light). -->
    <DockPanel Margin="22,18" MaxWidth="520" MinWidth="300">
        <StackPanel x:Name="Buttons" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0" />
        <TextBlock x:Name="Glyph" DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26"
                   Margin="0,2,16,0" VerticalAlignment="Top" />
        <TextBox x:Name="Message" Style="{x:Null}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Ink}" SelectionBrush="{DynamicResource Accent}"
                 TextWrapping="Wrap" MaxWidth="480" FontSize="13.5" VerticalAlignment="Center" AutomationProperties.Name="Message" />
    </DockPanel>
</Window>
