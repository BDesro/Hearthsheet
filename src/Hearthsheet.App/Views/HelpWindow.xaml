<Window x:Class="Hearthsheet.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hearthsheet help" Style="{StaticResource AppWindow}" Width="680" Height="760" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackButton" Content="← Back" Click="OnBack" IsEnabled="False" Padding="10,4"
                        AutomationProperties.Name="Back" />
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="Body" Margin="28,20" MaxWidth="600" HorizontalAlignment="Left" />
        </ScrollViewer>
    </DockPanel>
</Window>
