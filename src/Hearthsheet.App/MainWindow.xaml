<Window x:Class="Hearthsheet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Hearthsheet.App.Views"
        xmlns:app="clr-namespace:Hearthsheet.Core.Application;assembly=Hearthsheet.Core"
        Title="Hearthsheet"
        Style="{StaticResource AppWindow}" Width="1360" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Closing="OnClosing">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCharacter}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCharacter}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ShowView}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ShowView}" CommandParameter="1" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ShowView}" CommandParameter="2" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomIn}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomIn}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOut}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOut}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ZoomReset}" />
        <KeyBinding Key="P" Modifiers="Control" Command="ApplicationCommands.Print" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Print" Executed="OnPrint" CanExecute="CanPrint" />
    </Window.CommandBindings>

    <Grid>
    <!-- Hidden (laid out but not drawn) while the intro plays, so the software-rendered video has the renderer to itself. -->
    <DockPanel x:Name="AppRoot" Visibility="Hidden">
        <!-- Toolbar: large buttons for the common commands; Help ▾ and ⋯ More open flat menus. Labels collapse below 1100 wide. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <DockPanel x:Name="Toolbar" Margin="8,4">
            <DockPanel.Resources>
                <Style x:Key="ToolbarLabel" TargetType="AccessText">
                    <Setter Property="Margin" Value="8,0,0,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tag, ElementName=Toolbar}" Value="Compact">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="ToolbarGlyph" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </DockPanel.Resources>

            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Click="OnOpenMenu" ToolTip="More commands"
                    AutomationProperties.Name="More commands">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xE712;" />
                    <AccessText Style="{StaticResource ToolbarLabel}" Text="_More" />
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_Import character…" Command="{Binding ImportCharacter}" />
                        <MenuItem Header="_Export character…" Command="{Binding ExportCharacter}" />
                        <MenuItem Header="Export a_ll characters…" Command="{Binding ExportAllCharacters}" AutomationProperties.Name="Export all characters" />
                        <MenuItem Header="_Duplicate character" Command="{Binding DuplicateCharacter}" />
                        <MenuItem Header="De_lete character…" Command="{Binding DeleteCharacter}" />
                        <Separator />
                        <MenuItem Header="Zoom _in" Command="{Binding ZoomIn}" InputGestureText="Ctrl++" />
                        <MenuItem Header="Zoom _out" Command="{Binding ZoomOut}" InputGestureText="Ctrl+−" />
                        <MenuItem Header="_Reset zoom" Command="{Binding ZoomReset}" InputGestureText="Ctrl+0" />
                        <Separator />
                        <MenuItem Header="Theme" IsEnabled="False" />
                        <MenuItem Header="Match _system" Command="{Binding SetTheme}" CommandParameter="System" IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                                  AutomationProperties.Name="Theme: match system" />
                        <MenuItem Header="Li_ght" Command="{Binding SetTheme}" CommandParameter="Light" IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                  AutomationProperties.Name="Theme: light" />
                        <MenuItem Header="Dar_k" Command="{Binding SetTheme}" CommandParameter="Dark" IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                  AutomationProperties.Name="Theme: dark" />
                        <Separator Visibility="{Binding Sync.IsConfigured, Converter={StaticResource VisibleWhen}}" />
                        <MenuItem Header="{Binding Sync.AccountLabel}" IsEnabled="False" Visibility="{Binding Sync.IsConfigured, Converter={StaticResource VisibleWhen}}" />
                        <MenuItem Header="Sign i_n…" Command="{Binding Sync.SignIn}" Visibility="{Binding Sync.IsConfigured, Converter={StaticResource VisibleWhen}}" />
                        <MenuItem Header="Sync _now" Command="{Binding Sync.SyncNow}" Visibility="{Binding Sync.IsConfigured, Converter={StaticResource VisibleWhen}}" />
                        <MenuItem Header="Sign _out" Command="{Binding Sync.SignOut}" Visibility="{Binding Sync.IsConfigured, Converter={StaticResource VisibleWhen}}" />
                        <Separator />
                        <MenuItem Header="Check for _updates…" Command="{Binding Update.ShowDialog}" />
                        <MenuItem Header="Open lo_g folder" Command="{Binding OpenLogs}" />
                        <MenuItem Header="Open _data folder" Command="{Binding OpenDataFolder}" />
                        <Separator />
                        <MenuItem Header="E_xit" Click="OnExit" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <TextBlock DockPanel.Dock="Right" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       AutomationProperties.Name="Signed in to cloud sync" ToolTip="Signed in to cloud sync"
                       Visibility="{Binding Sync.IsSignedIn, Converter={StaticResource VisibleWhen}}">
                <Run Text="●" Foreground="{DynamicResource Good}" /> <Run Text="{Binding Sync.AccountEmail, Mode=OneWay}" />
            </TextBlock>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding NewCharacter}" ToolTip="New character (Ctrl+N)" AutomationProperties.Name="New character">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xE710;" />
                        <AccessText Style="{StaticResource ToolbarLabel}" Text="_New character" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding SaveCharacter}" ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xE74E;" />
                        <AccessText Style="{StaticResource ToolbarLabel}" Text="_Save" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="ApplicationCommands.Print" ToolTip="Print sheet (Ctrl+P)" AutomationProperties.Name="Print sheet">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xE749;" />
                        <AccessText Style="{StaticResource ToolbarLabel}" Text="_Print sheet" />
                    </StackPanel>
                </Button>
                <!-- Sync slot: Sync now when signed in, Sign in when sync is configured but signed out. -->
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding Sync.SyncNow}" ToolTip="Sync now" AutomationProperties.Name="Sync now"
                        Visibility="{Binding Sync.IsSignedIn, Converter={StaticResource VisibleWhen}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xE895;" />
                        <AccessText Style="{StaticResource ToolbarLabel}" Text="S_ync now" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding Sync.SignIn}" ToolTip="Sign in to cloud sync" AutomationProperties.Name="Sign in"
                        Visibility="{Binding Sync.CanSignIn, Converter={StaticResource VisibleWhen}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xE77B;" />
                        <AccessText Style="{StaticResource ToolbarLabel}" Text="Sign _in…" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="OnOpenMenu" ToolTip="Help" AutomationProperties.Name="Help">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ToolbarGlyph}" Text="&#xE897;" />
                        <AccessText Style="{StaticResource ToolbarLabel}" Text="_Help ▾" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="_Tutorial" Command="{Binding ShowHelp}" CommandParameter="tutorial.md" />
                            <MenuItem Header="_Beginner's guide to 5e" Command="{Binding ShowHelp}" CommandParameter="beginners-guide.md" />
                            <MenuItem Header="Look up rules (D&amp;D 5e _wikidot)" Command="{Binding OpenWikidot}" />
                            <Separator />
                            <MenuItem Header="_Legal and credits" Command="{Binding ShowHelp}" CommandParameter="legal.md" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </DockPanel>
        </Border>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center">
                    <Run Text="Hearthsheet" /> <Run Text="{Binding AppVersion, Mode=OneWay}" />
                </TextBlock>
                <Button DockPanel.Dock="Right" Margin="0,0,14,0" Padding="10,1" MinHeight="22" Command="{Binding Update.ShowDialog}"
                        Visibility="{Binding Update.IsUpdateAvailable, Converter={StaticResource VisibleWhen}}"
                        Content="{Binding Update.Available.Version}" ContentStringFormat="Update {0} available" />
                <Button DockPanel.Dock="Right" Margin="0,0,14,0" Padding="8,1" MinHeight="22" Command="{Binding Sync.SyncNow}"
                        Content="{Binding Sync.Status}" ToolTip="Sync now" AutomationProperties.Name="Cloud sync status. Sync now"
                        Visibility="{Binding Sync.IsConfigured, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Text="{Binding Shell.SaveStatus}" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Character list -->
            <DockPanel Background="{DynamicResource Sidebar}">
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,8">
                    <TextBlock Text="Characters" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <UniformGrid Columns="2">
                        <Button Content="+ New" Style="{StaticResource AccentButton}" Command="{Binding NewCharacter}" Margin="0,0,4,0" />
                        <Button Content="Import…" Command="{Binding ImportCharacter}" Margin="4,0,0,0" />
                    </UniformGrid>
                </StackPanel>
                <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="14,6,14,12">
                    <Button Content="Duplicate" Command="{Binding DuplicateCharacter}" Margin="0,0,4,0" Padding="4,5" />
                    <Button Content="Export…" Command="{Binding ExportCharacter}" Margin="2,0" Padding="4,5" />
                    <Button Content="Delete" Command="{Binding DeleteCharacter}" Foreground="{DynamicResource Danger}" Margin="4,0,0,0" Padding="4,5" />
                </UniformGrid>
                <Grid>
                    <ListBox ItemsSource="{Binding Shell.Characters}" SelectedItem="{Binding Shell.SelectedSummary}" Background="Transparent" BorderThickness="0"
                             Padding="8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Characters">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="Padding" Value="10,7" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type app:CharacterSummary}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource InkMuted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Margin="16,8"
                                Visibility="{Binding Shell.Characters.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}"
                                   Text="No characters yet. Create one or import a .dndchar file." />
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0">
                            <Hyperlink Command="{Binding ShowHelp}" CommandParameter="tutorial.md">New to Hearthsheet? Read the tutorial</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource Line}"
                          ResizeBehavior="PreviousAndNext" Focusable="False" />

            <!-- Empty state -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding HasCharacter, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                <TextBlock Text="No character open" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,8,0,18"
                           Text="Create a new character to fill in the sheet, or import one exported from Hearthsheet." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Create character" Style="{StaticResource AccentButton}" Command="{Binding NewCharacter}" Margin="0,0,8,0" Padding="16,7" />
                    <Button Content="Import…" Command="{Binding ImportCharacter}" Padding="16,7" />
                </StackPanel>
            </StackPanel>

            <!-- One character, three views -->
            <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedView}" BorderThickness="0" Padding="0" Background="{DynamicResource Canvas}"
                        Visibility="{Binding HasCharacter, Converter={StaticResource VisibleWhen}}">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource ViewTab}" />
                </TabControl.Resources>
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                                <DockPanel Margin="16,0">
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Shell.Current.Title}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Shell.Current.Summary}" Foreground="{DynamicResource InkMuted}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                                </DockPanel>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="Character Sheet">
                    <views:SheetView x:Name="Sheet" DataContext="{Binding Shell.Current}" />
                </TabItem>
                <TabItem Header="Details">
                    <views:DetailsView DataContext="{Binding Shell.Current}" />
                </TabItem>
                <TabItem Header="Play">
                    <views:PlayView DataContext="{Binding Shell.Current}" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>

    <!-- Logo intro: plays over black on launch; a click skips it. -->
    <Grid x:Name="Intro" Background="{DynamicResource IntroBackdrop}" ClipToBounds="True" Cursor="Hand" MouseDown="OnIntroDown">
        <MediaElement x:Name="IntroVideo" LoadedBehavior="Manual" Stretch="Uniform" IsHitTestVisible="False"
                      Loaded="OnIntroLoaded" MediaOpened="OnIntroOpened" MediaEnded="OnIntroDone" MediaFailed="OnIntroDone" />
    </Grid>
    </Grid>
</Window>
