@inject IConfiguration Config

@if (!SelfCheckPassed)
{
    <p role="alert">This build can't save changes. Please report it.</p>
}
else
{
    @if (Config.GetValue<bool>("Preview"))
    {
        <div class="preview-banner" role="note">Preview – not the final Hearthsheet. Don't rely on it for real characters.</div>
    }
    <h1>Hearthsheet</h1>
    @if (_error is not null)
    {
        <p role="alert">@_error</p>
    }
    @if (_lock is null)
    {
        @if (_error is null)
        {
            <p>Loading…</p>
        }
    }
    else if (_lock.IsReadOnly)
    {
        <OtherTab Lock="_lock" TookOver="OpenStorageAsync" />
    }
    else if (_busy is not null || _storage is null || _auth is null)
    {
        <p role="status">@(_busy ?? "Loading…")</p>
    }
    else if (_account is null)
    {
        <SignIn Auth="_auth" SignedIn="OnSignedInAsync" />
    }
    else
    {
        <header class="account" aria-label="Account">
            <span>@(_account.Email ?? "Signed in")</span>
            <button type="button" @onclick="SignOutAsync" disabled="@(_askSignOut is not null)">Sign out</button>
        </header>
        @if (_askSignOut is { } unsynced)
        {
            <SignOutDialog Unsynced="unsynced" Busy="_signOutBusy" Error="@_signOutError" Chosen="OnSignOutChosenAsync" />
        }
        else
        {
            @if (!_auth.IsSignedIn)
            {
                <p role="status" class="signed-out">Signed out – sign in to resume sync</p>
                <SignIn Auth="_auth" Email="@_account.Email" SignedIn="OnSignedInAsync" />
            }
            @if (DevPage is not null)
            {
                <DynamicComponent @key="_account" Type="DevPage" Parameters="DevParameters" />
            }
        }
    }
}

@code {
    [Parameter] public bool SelfCheckPassed { get; set; }
}
